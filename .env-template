# ============================================================
# Python Template V2 环境变量配置模板
# 复制此文件为 .env 并根据需要修改
# ============================================================

# ========== 应用环境 ==========
# 可选值: local / dev / prod
# local: 本地开发，使用彩色日志，可能启用代理
# dev:   开发环境，JSON 日志，调试模式
# prod:  生产环境，JSON 结构化日志
APP_ENVIRONMENT=local

# ========== 服务配置 ==========
APP_HOST=0.0.0.0
APP_PORT=8000
APP_WORKERS=1
APP_DEBUG=true

# ========== 日志配置 ==========
APP_LOG_LEVEL=DEBUG

# ========== 代理配置 (仅本地开发) ==========
# 如需通过代理访问外部资源，取消注释并修改
# HTTP_PROXY=http://10.0.1.223:7890
# HTTPS_PROXY=http://10.0.1.223:7890
